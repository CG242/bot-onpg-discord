DISCORD_TOKEN=
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ft_championship
START_DATE=2026-01-01
SCORES_CHANNEL=Scores-ft-congo
# Optionnel : un salon par ville (région auto-assignée aux joueurs du score)
SCORES_CHANNEL_BZ=
SCORES_CHANNEL_PN=
LEADERBOARD_CHANNEL=classement
# Sync automatique Discord ↔ base (secondes, défaut 180)
AUTO_SYNC_SECONDS=180
# Dossier des sauvegardes JSON (/backup, /restore)
BACKUP_DIR=backups
# Seuil similarité dédup joueurs (0.0–1.0, défaut 0.88)
SIMILARITY_THRESHOLD=0.88
# ID du serveur Discord a gerer (clic droit serveur > Copier l identifiant)
GUILD_ID=
ADMIN_ROLE_ID=